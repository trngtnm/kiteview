require 'pathname'

# Walk up from this Podfile until we find the workspace node_modules.
ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'

react_native_macos = (ws_dir + 'node_modules/react-native-macos').relative_path_from(Pathname.new(__dir__)).to_s

require "#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb"

prepare_react_native_project!

target 'KiteView-macOS' do
  platform :macos, '14.0'
  use_native_modules!

  use_react_native!(
    :path => react_native_macos,
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(installer)

    # Hermes aggregate target scripts require REACT_NATIVE_PATH; it is not always
    # inherited from the app target after `pod install` (e.g. adding AsyncStorage).
    rn_path = File.expand_path("#{Pod::Config.instance.installation_root}/../node_modules/react-native-macos")
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['REACT_NATIVE_PATH'] = rn_path
      end
    end
  end
end
